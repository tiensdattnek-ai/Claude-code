# ============================================================
#  Claude Code Web Console — environment configuration
#  Copy to `.env` and adjust. Everything below is optional;
#  sensible defaults are used when a value is missing.
# ============================================================

# --- Web server -------------------------------------------------
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# --- Admin account ----------------------------------------------
# Username used to sign in to the console (required).
ADMIN_USERNAME=admin
# Password. If you omit ADMIN_PASSWORD, a strong random password is
# generated on first boot, stored (hashed) in data/secrets.json and
# printed once in the server console.
ADMIN_PASSWORD=change-me-to-something-strong
# Optional: scrypt hash (scrypt$salt$hash). Takes precedence over ADMIN_PASSWORD.
# ADMIN_PASSWORD_HASH=

# How long a sign-in session stays alive before requiring re-login.
SESSION_TTL_HOURS=12

# --- AI engines --------------------------------------------------
# Which engine answers chats:
#   auto   - best available: Claude Code CLI -> Anthropic API -> Laguna -> Menos
#   cli    - spawns the local `claude` CLI in this sandbox (default intent)
#   api    - calls the Anthropic Messages API directly
#   menos  - Menos AI: local, offline, trainable knowledge brain (52 topics)
#   laguna - Laguna S 2.1: OpenRouter-compatible hosted model
#   demo   - offline simulated assistant (legacy fallback)
ENGINE=auto

# Menos AI (engine=menos) — không cần credential, không gọi mạng.
# Não bộ: server/engines/menos-knowledge.js (seed) + data/menos-brain.json
# (tri thức học thêm qua POST /api/menos/learn — tự động, git-ignored).

# Claude Code CLI engine (chat is executed INSIDE this machine/sandbox).
CLAUDE_CLI_BIN=claude
# Optional model override, e.g. claude-sonnet-4-5 or claude-opus-4-1
# CLAUDE_CLI_MODEL=
# Working directory the CLI agent operates in (defaults to the project root).
# WORKDIR=/home/user/Claude-code
# Tools the CLI agent may use when the "Agent tools" toggle is enabled.
ALLOWED_TOOLS=Bash,Edit,Write,Read,Glob,Grep,WebSearch,WebFetch
# Agent tool-call turns before a final answer is forced.
CLI_MAX_TURNS=30

# Anthropic API engine.
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
CLAUDE_MODEL=claude-sonnet-4-5
API_MAX_TOKENS=8192

# Laguna S 2.1 engine (OpenRouter-compatible /chat/completions).
# Leave OPENROUTER_API_KEY empty to disable; auto-fallback goes to Menos.
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# LAGUNA_MODEL=anthropic/claude-sonnet-4.5

# --- Limits ------------------------------------------------------
MAX_MESSAGE_CHARS=60000
DATA_DIR=./data
